!.config/nvim/lua/plugins/*

# powershell
!.config/powershell/
!.config/powershell/*

# ssh
!.ssh/
!.ssh/authorized_keys
!.ssh/config

# vim
!.config/vim/
!.config/vim/vimrc
!_vimrc

# yazi
!.config/yazi/
