# Ignore everything - let's not push some secrets ;)
*

# except some important ones maybe
!.config/
!.local/
!.local/bin/
!.gitignore
!README.md

# dunst
!.config/dunst
!.config/dunst/*

# fcitx
!.config/fcitx/
!.config/fcitx/*
!.config/fcitx5/
!.config/fcitx5/*

# fontconfig
!.config/fontconfig/ !.config/fontconfig/**

# git
!.config/git/
!.config/git/config

# gtk
!.config/nwg-look/
!.config/nwg-look/*
!.config/.gtkrc-2.0
!.config/gtk-3.0/
!.config/gtk-3.0/*.ini
!.config/gtk-4.0/
!.config/gtk-4.0/*.ini
!.config/gtk-4.0/*.css
!.config/xsettingsd/
!.config/xsettingsd/*

# hypr
!.config/hypr/
!.config/hypr/*
!.config/hypr/config/
!.config/hypr/config/*

# l
!.local/bin/l

# kitty
!/.config/kitty/
!/.config/kitty/*

# obs-studio
!.config/obs-studio/
!.config/obs-studio/global.ini

# shell
!.bashrc
!.profile
!.config/shell/
!.config/shell/**

# thunar
!.config/Thunar/
!.config/Thunar/*

# vim
!.config/vim/
!.config/vim/*

# waybar
!.config/waybar/
!.config/waybar/*

# wofi
!.config/wofi/
!.config/wofi/*

# yazi
!.config/yazi/
!.config/yazi/*
