# Ignore everything - let's not push some secrets ;)
*

# except some important ones maybe
!.config/
!.gitignore
!README.md

# git
!.config/git/
!.config/git/config

# hypr
!.config/hypr/
!.config/hypr/*
!.config/hypr/config/
!.config/hypr/config/*

# kitty
!/.config/kitty/
!/.config/kitty/*

# shell
!.bashrc
!.profile
!.config/shell/
!.config/shell/**

# vim
!.config/vim/
!.config/vim/*

# waybar
!.config/waybar/
!.config/waybar/*

# wofi
!.config/wofi/
!.config/wofi/*
