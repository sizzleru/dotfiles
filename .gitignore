# Ignore everything - let's not push some secrets ;)
*

# except some important ones maybe
!.config/
!.local/
!.local/bin/
!.gitignore
!README.md

# copy
!.local/bin/copy

# deploy
!.local/bin/deploy

# git
!.config/git/
!.config/git/config

# move
!.local/bin/move

# nvim
!.config/nvim/
!.config/nvim/init.lua
!.config/nvim/lua/
!.config/nvim/lua/config/
!.config/nvim/lua/config/*
!.config/nvim/lua/core/
!.config/nvim/lua/core/*
!.config/nvim/lua/keymaps/
!.config/nvim/lua/keymaps/*
!.config/nvim/lua/plugins/
!.config/nvim/lua/plugins/*

# ssh
!.ssh/
!.ssh/authorized_keys
!.ssh/config

# yazi
!.config/yazi/
!.config/yazi/init.lua
!.config/yazi/yazi.toml
!.config/yazi/keymap.toml
!.config/yazi/theme.toml

# shell
!.bashrc
!.bash_profile
!.profile
!.config/shell/
!.config/shell/**

# vim
!.config/vim/
!.config/vim/vimrc
